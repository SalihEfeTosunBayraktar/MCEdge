{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcedge/element-type.schema.json",
  "title": "MCEdge element type definition",
  "type": "object",
  "required": ["id", "folder", "name", "description", "icon", "pages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "folder": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "shortcut": { "type": "string", "maxLength": 1 },
    "langKey": { "type": ["string", "null"] },
    "mcreator": { "type": "string" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "groups"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "fields"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string" },
                "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "description": "showIf condition. A leaf is { key, <one operator> }; all/any combine conditions.",
      "oneOf": [
        { "type": "object", "required": ["all"], "additionalProperties": false, "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "required": ["any"], "additionalProperties": false, "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        {
          "type": "object", "required": ["key"], "additionalProperties": false, "minProperties": 2, "maxProperties": 2,
          "properties": {
            "key": { "type": "string" }, "equals": {}, "notEquals": {}, "in": { "type": "array" }, "notIn": { "type": "array" },
            "gt": { "type": "number" }, "gte": { "type": "number" }, "lt": { "type": "number" }, "lte": { "type": "number" }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "required": ["key", "type", "label"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
        "type": {
          "enum": ["text", "multiline", "integer", "number", "boolean", "select", "multiselect", "texture", "model", "sound",
            "color", "item", "block", "entity", "biome", "effect", "enchantment", "potion", "particle", "dimension",
            "damage_type", "villager_profession", "structure", "attribute", "tag", "element", "procedure", "range", "vector",
            "list", "map", "recipe_grid", "gui_layout", "blockly", "tab_order"]
        },
        "label": { "type": "string" },
        "help": { "type": "string" },
        "default": {},
        "required": { "type": "boolean" },
        "showIf": { "$ref": "#/$defs/condition" },
        "mcreator": { "type": "string" },
        "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number" },
        "maxLength": { "type": "integer" }, "pattern": { "type": "string" },
        "options": { "type": "array", "items": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": ["string", "number", "boolean"] }, "label": { "type": "string" } } } },
        "textureKind": { "type": "string" }, "modelKinds": { "type": "array" }, "allowTags": { "type": "boolean" }, "tagKind": { "type": "string" },
        "elementTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "multiple": { "type": "boolean" }, "allowCustom": { "type": "boolean" },
        "trigger": { "type": "string" }, "dependencies": { "type": "array", "items": { "type": "string" } }, "returns": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }, "minItems": { "type": "integer" }, "maxItems": { "type": "integer" },
        "keyField": { "$ref": "#/$defs/field" }, "valueField": { "$ref": "#/$defs/field" }, "size": { "type": "integer" }
      }
    }
  }
}
