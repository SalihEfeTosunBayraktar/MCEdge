    "breakSound": {
      "title": "Break sound",
      "type": "string"
    },
    "fallSound": {
      "title": "Fall sound",
      "type": "string"
    },
    "hitSound": {
      "title": "Hit sound",
      "type": "string"
    },
    "placeSound": {
      "title": "Place sound",
      "type": "string"
    },
    "stepSound": {
      "title": "Step sound",
      "type": "string"
    },
    "customDrop": {
      "title": "Drop",
      "description": "Item dropped instead of the block itself.",
      "type": "string"
    },
    "dropAmount": {
      "title": "Drop amount",
      "description": "0 drops nothing.",
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "useLootTableForDrops": {
      "title": "Use a loot table",
      "description": "Drops come from a loot table element instead of the settings above.",
      "type": "boolean"
    },
    "xpAmountMin": {
      "title": "Experience: minimum",
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "xpAmountMax": {
      "title": "Experience: maximum",
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "creativePickItem": {
      "title": "Pick block item",
      "description": "Item given on middle click in creative. Empty uses the block item.",
      "type": "string"
    },
    "requiresCorrectTool": {
      "title": "Needs correct tool",
      "description": "Drops nothing unless mined with the right tool.",
      "type": "boolean"
    },
    "destroyTool": {
      "title": "Tool",
      "description": "Tool type that mines it fastest.",
      "enum": [
        "Not specified",
        "pickaxe",
        "axe",
        "shovel",
        "hoe"
      ]
    },
    "vanillaToolTier": {
      "title": "Minimum tier",
      "description": "Lowest tool tier that can harvest it.",
      "enum": [
        "NONE",
        "STONE",
        "IRON",
        "DIAMOND"
      ]
    },
    "additionalHarvestCondition": {
      "title": "Extra harvest condition",
      "description": "Optional; return false to block harvesting.",
      "type": "string"
    },
    "material": {
      "title": "Material",
      "description": "The block's material. It sets the default map color, whether lava ignites the block, and on Minecraft 1.16.5 how fast a pickaxe breaks it (only metal and stone are fast).",
      "enum": [
        "STONE",
        "METAL",
        "HEAVY_METAL",
        "WOOD",
        "GLASS",
        "DIRT",
        "SAND",
        "GRASS",
        "WOOL",
        "CLAY",
        "ICE"
      ]
    },
    "colorOnMap": {
