{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcedge/elements/block.schema.json",
  "title": "MCEdge Block element",
  "description": "A placeable block: model, states, properties, inventory, energy, events and ore generation.",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "title": {
      "type": "string"
    },
    "blockBase": {
      "title": "Block base",
      "description": "Start from a vanilla block shape and behavior. Empty is a plain custom block.",
      "enum": [
        "",
        "Stairs",
        "Slab",
        "Fence",
        "Wall",
        "Leaves",
        "TrapDoor",
        "Pane",
        "Door",
        "FenceGate",
        "EndRod",
        "PressurePlate",
        "Button",
        "FlowerPot",
        "Sign",
        "HangingSign"
      ]
    },
    "hasGravity": {
      "title": "Falls like sand",
      "description": "Falls when nothing supports it. Not available with waterlogging.",
      "type": "boolean"
    },
    "blockSetType": {
      "title": "Sound and redstone set",
      "description": "Material set used by doors, trapdoors, pressure plates and buttons.",
      "enum": [
        "OAK",
        "STONE",
        "IRON"
      ]
    },
    "leavesParticleType": {
      "title": "Falling leaf particle",
      "description": "Particle dropping from leaves. Empty uses the default.",
      "type": "string"
    },
    "leavesParticleChance": {
      "title": "Leaf particle chance",
      "description": "Chance per display tick.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pottedPlant": {
      "title": "Potted plant",
      "description": "Plant shown inside the flower pot.",
      "type": "string"
    },
    "signEntityTexture": {
      "title": "Sign texture",
      "description": "Entity texture of the sign.",
      "type": "string"
    },
    "signGUITexture": {
      "title": "Hanging sign edit screen",
      "description": "Background of the text editing screen.",
      "type": "string"
    },
    "texture": {
      "title": "Main texture",
      "description": "Texture used on every side unless a side texture below is set (bottom face for cubes).",
      "type": "string"
    },
    "textureTop": {
      "title": "Top texture",
      "description": "Optional.",
      "type": "string"
    },
    "textureLeft": {
      "title": "Left texture",
      "description": "Optional.",
      "type": "string"
    },
    "textureFront": {
      "title": "Front texture",
      "description": "Optional.",
      "type": "string"
    },
    "textureRight": {
      "title": "Right texture",
      "description": "Optional.",
      "type": "string"
    },
    "textureBack": {
      "title": "Back texture",
      "description": "Optional.",
      "type": "string"
    },
    "renderType": {
      "title": "Model type",
      "description": "Built-in shape or a custom model. Tinted variants are picked automatically when a tint is set.",
      "enum": [
        10,
        11,
        110,
        12,
        120,
        13,
        14,
        15,
        150,
        2,
        3,
        4
      ]
    },
    "customModelName": {
      "title": "Model",
      "description": "Built-in model name (\"Normal\", \"Single texture\", \"Cross model\", \"Crop model\", \"Grass block\", \"Potted plant\") or a custom model.",
      "type": "string"
    },
    "itemTexture": {
      "title": "Item texture",
      "description": "Optional flat inventory icon instead of the 3D block.",
      "type": "string"
    },
    "itemDisplay": {
      "title": "Item display transforms",
      "description": "Optional JSON object for the block item model's \"display\" (gui, ground, fixed, thirdperson_righthand, ...), each with rotation, translation and scale.",
      "type": "string"
    },
    "particleTexture": {
      "title": "Particle texture",
      "description": "Optional texture for break particles.",
      "type": "string"
    },
    "specialInformation": {
      "title": "Tooltip lines",
      "description": "Extra tooltip lines under the name, one per row.",
      "type": "string"
    },
    "specialInformationProcedure": {
      "title": "Tooltip lines procedure",
      "description": "Optional procedure that returns the tooltip lines instead of the fixed list.",
      "type": "string"
    },
    "rotationMode": {
      "title": "Rotation",
      "description": "How the block faces when placed.",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5
      ]
    },
    "enablePitch": {
      "title": "Floor, wall and ceiling",
      "description": "Also allow facing up and down (only for the horizontal rotation modes).",
      "type": "boolean"
    },
    "isWaterloggable": {
      "title": "Waterloggable",
      "description": "Can hold water like stairs and slabs.",
      "type": "boolean"
    },
    "hasTransparency": {
      "title": "Has transparency",
      "description": "The block does not fill the full cube or has see-through pixels.",
      "type": "boolean"
    },
    "transparencyType": {
      "title": "Render layer",
      "description": "How transparent pixels are drawn.",
      "enum": [
        "SOLID",
        "CUTOUT",
        "CUTOUT_MIPPED",
        "TRANSLUCENT"
      ]
    },
    "connectedSides": {
      "title": "Hide shared faces",
      "description": "Faces touching the same block are not drawn, like glass.",
      "type": "boolean"
    },
    "displayFluidOverlay": {
      "title": "Show fluid overlay",
      "description": "Show the water overlay texture instead of hiding faces next to water.",
      "type": "boolean"
    },
    "tintType": {
      "title": "Tint",
      "description": "Color the texture with a biome color.",
      "enum": [
        "No tint",
        "Grass",
        "Foliage",
        "Dry foliage",
        "Birch foliage",
        "Spruce foliage",
        "Default foliage",
        "Water",
        "Sky",
        "Fog",
        "Water fog"
      ]
    },
    "isItemTinted": {
      "title": "Tint the item too",
      "description": "Apply the same tint to the inventory item.",
      "type": "boolean"
    },
    "offsetType": {
      "title": "Random offset",
      "description": "Random position shift like flowers have.",
      "enum": [
        "NONE",
        "XZ",
        "XYZ"
      ]
    },
    "disableOffset": {
      "title": "Ignore offset for boxes",
      "description": "Keep the boxes in place even when the block is randomly offset.",
      "type": "boolean"
    },
    "isNotColidable": {
      "title": "Walk through",
      "description": "Entities can pass through the block.",
      "type": "boolean"
    },
    "boundingBoxes": {
      "title": "Boxes",
      "description": "Outline and collision shape in pixels (0-16 per axis).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mx": {
            "title": "From X",
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "my": {
            "title": "From Y",
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "mz": {
            "title": "From Z",
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "Mx": {
            "title": "To X",
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "My": {
            "title": "To Y",
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "Mz": {
            "title": "To Z",
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "subtract": {
            "title": "Subtract",
            "description": "Cut this box out of the previous ones instead of adding it.",
            "type": "boolean"
          }
        }
      }
    },
    "customProperties": {
      "title": "Properties",
      "description": "Extra block state properties (logic, integer, number or text) with their default value.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "enum": [
              "logic",
              "integer",
              "number",
              "string"
            ]
          },
          "min": {
            "title": "Minimum",
            "type": "number"
          },
          "max": {
            "title": "Maximum",
            "type": "number"
          },
          "arrayData": {
            "title": "Allowed values",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "title": "Value",
                  "type": "string"
                }
              }
            }
          },
          "value": {
            "title": "Default value",
            "description": "Starting value, written as text (true/false, a number or one of the allowed values).",
            "type": "string"
          }
        }
      }
    },
    "multipartModel": {
      "title": "Multipart format",
      "description": "Write the block states as multipart instead of variants.",
      "type": "boolean"
    },
    "states": {
      "title": "State overrides",
      "description": "Different model, textures or boxes for specific property values.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stateMap": {
            "title": "When",
            "description": "Property values this entry applies to.",
            "type": "object",
            "additionalProperties": {
              "title": "Value",
              "type": "string"
            }
          },
          "texture": {
            "title": "Main texture",
            "description": "Texture used on every side unless a side texture below is set (bottom face for cubes).",
            "type": "string"
          },
          "textureTop": {
            "title": "Top texture",
            "description": "Optional.",
            "type": "string"
          },
          "textureLeft": {
            "title": "Left texture",
            "description": "Optional.",
            "type": "string"
          },
          "textureFront": {
            "title": "Front texture",
            "description": "Optional.",
            "type": "string"
          },
          "textureRight": {
            "title": "Right texture",
            "description": "Optional.",
            "type": "string"
          },
          "textureBack": {
            "title": "Back texture",
            "description": "Optional.",
            "type": "string"
          },
          "renderType": {
            "title": "Model type",
            "enum": [
              10,
              11,
              110,
              12,
              120,
              13,
              14,
              15,
              150,
              2,
              3,
              4
            ]
          },
          "customModelName": {
            "title": "Model",
            "type": "string"
          },
          "particleTexture": {
            "title": "Particle texture",
            "type": "string"
          },
          "hasCustomBoundingBox": {
            "title": "Own bounding boxes",
            "type": "boolean"
          },
          "boundingBoxes": {
            "title": "Boxes",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mx": {
                  "title": "From X",
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "my": {
                  "title": "From Y",
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "mz": {
                  "title": "From Z",
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "Mx": {
                  "title": "To X",
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "My": {
                  "title": "To Y",
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "Mz": {
                  "title": "To Z",
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "subtract": {
                  "title": "Subtract",
                  "description": "Cut this box out of the previous ones instead of adding it.",
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "animations": {
      "title": "Animations",
      "description": "Animations played by a Java model block (needs the custom Java model type).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "animation": {
            "title": "Animation",
            "description": "Animation id from the workspace.",
            "type": "string"
          },
          "speed": {
            "title": "Speed",
            "type": "number",
            "minimum": 0
          },
          "condition": {
            "title": "Play condition",
            "description": "Optional; the animation plays while this returns true.",
            "type": "string"
          }
        }
      }
    },
    "name": {
      "title": "Name",
      "description": "Display name of the block.",
      "type": "string"
    },
    "hardness": {
      "title": "Hardness",
      "description": "Time needed to break it. -1 makes it unbreakable.",
      "type": "number",
      "minimum": -1,
      "maximum": 64000
    },
    "resistance": {
      "title": "Blast resistance",
      "type": "number",
      "minimum": 0,
      "maximum": 2147483647
    },
    "unbreakable": {
      "title": "Unbreakable",
      "description": "Cannot be broken in survival, like bedrock.",
      "type": "boolean"
    },
    "hasCustomOpacity": {
      "title": "Custom light opacity",
      "description": "Set how much light the block blocks.",
      "type": "boolean"
    },
    "lightOpacity": {
      "title": "Light opacity",
      "description": "0 lets all light through, 15 blocks it fully.",
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "emissiveRendering": {
      "title": "Glowing texture",
      "description": "Render at full brightness even in the dark.",
      "type": "boolean"
    },
    "hasPostProcess": {
      "title": "Post-process render",
      "description": "Marks the block for the post-process render step, used for glowing blocks. Not available on Minecraft 26.x, which removed it.",
      "type": "boolean"
    },
    "isReplaceable": {
      "title": "Replaceable",
      "description": "Other blocks can be placed into it, like tall grass.",
      "type": "boolean"
    },
    "hasBlockItem": {
      "title": "Has an item",
      "description": "Create an item form of the block.",
      "type": "boolean"
    },
    "maxStackSize": {
      "title": "Stack size",
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "rarity": {
      "title": "Rarity",
      "enum": [
        "COMMON",
        "UNCOMMON",
        "RARE",
        "EPIC"
      ]
    },
    "immuneToFire": {
      "title": "Fireproof item",
      "type": "boolean"
    },
    "creativeTabs": {
      "title": "Creative tabs",
      "description": "Creative inventory tabs that list this element. Tabs defined in this mod are offered as well.",
      "type": "array",
      "items": {}
    },
    "isCustomSoundType": {
      "title": "Custom sounds",
      "description": "Pick each sound yourself instead of a vanilla sound set.",
      "type": "boolean"
    },
    "soundOnStep": {
      "title": "Sound set",
      "description": "Vanilla sound set for breaking, stepping and placing.",
      "enum": [
        "GROUND",
        "EMPTY",
        "WOOD",
        "PLANT",
        "LILY_PADS",
        "STONE",
        "METAL",
        "GLASS",
        "CLOTH",
        "SAND",
        "SNOW",
