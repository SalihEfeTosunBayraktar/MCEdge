{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcedge/engine.schema.json",
  "title": "MCEdge engine plugin manifest",
  "type": "object",
  "required": ["id", "apiVersion", "name", "minecraft", "loader", "java", "gradle", "layers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "apiVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "minecraft": { "type": "string" },
    "loader": { "type": "string" },
    "java": { "type": "integer", "minimum": 8 },
    "gradle": {
      "type": "object",
      "required": ["version", "jdk"],
      "additionalProperties": false,
      "properties": { "version": { "type": "string" }, "jdk": { "type": "integer" } }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Template layers in order; \"@name\" refers to a shared layer, other entries to folders inside the engine"
    },
    "versions": { "type": "object", "additionalProperties": { "type": "string" } },
    "api": { "type": "object", "additionalProperties": { "type": "string" } },
    "creativeTabs": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Vanilla creative tab values of element types (MCreator names such as MATERIALS) -> the engine's tab constant; unmapped tabs are skipped"
    }
  }
}
