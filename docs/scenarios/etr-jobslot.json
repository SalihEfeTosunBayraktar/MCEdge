    { "label": "slot 5", "op": "call", "procedure": "job_pick_slot_item", "expect": { "matches": "^1 [a-z_]+$" } },
    { "op": "set", "name": "proc_job_slot", "value": 6 },
    { "label": "slot 6", "op": "call", "procedure": "job_pick_slot_item", "expect": { "matches": "^1 [a-z_]+$" } },
    { "op": "set", "name": "proc_job_slot", "value": 7 },
    { "label": "slot 7", "op": "call", "procedure": "job_pick_slot_item", "expect": { "matches": "^1 [a-z_]+$" } },
    { "op": "set", "name": "proc_job_slot", "value": 8 },
    { "label": "slot 8", "op": "call", "procedure": "job_pick_slot_item", "expect": { "matches": "^1 [a-z_]+$" } }
  ]
