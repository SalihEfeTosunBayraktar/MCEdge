{
  "name": "ETR TakasProbe: trade offer, right-click pairing, third player, shared slots, swap, leave, status bubbles (Q130, Q132)",
  "steps": [
    { "op": "player", "name": "Ali", "pos": [0.5,101,0.5] },
    { "op": "player", "name": "Bora", "pos": [1.5,101,0.5] },
    { "op": "player", "name": "Cem", "pos": [2.5,101,0.5] },
    { "op": "set", "player": "Ali", "name": "Money", "value": 100 },
    { "op": "set", "player": "Bora", "name": "Money", "value": 50 },
    { "label": "click without an offer", "op": "call", "procedure": "trade_player_clicked", "args": {"entity": "Ali", "sourceentity": "Bora"} },
    { "op": "read", "what": "menu", "player": "Bora" },
    { "label": "offer opens", "op": "call", "procedure": "trade_offer_command", "args": {"entity": "Ali"} },
    { "label": "bubble after open", "op": "read", "what": "bubble", "player": "Ali", "expect": {"contains": "trade_offer"} },
    { "label": "offer cancels", "op": "call", "procedure": "trade_offer_command", "args": {"entity": "Ali"} },
    { "label": "bubble after cancel", "op": "read", "what": "bubble", "player": "Ali", "expect": {"contains": "trade_cancel"} },
    { "op": "call", "procedure": "trade_offer_command", "args": {"entity": "Ali"} },
    { "label": "pair", "op": "call", "procedure": "trade_player_clicked", "args": {"entity": "Ali", "sourceentity": "Bora"} },
    { "label": "Ali menu", "op": "read", "what": "menu", "player": "Ali", "expect": {"contains": "PlayerTradeguiMenu"} },
    { "label": "Bora menu", "op": "read", "what": "menu", "player": "Bora", "expect": {"contains": "PlayerTradeguiMenu"} },
    { "label": "Ali bubble", "op": "read", "what": "bubble", "player": "Ali", "expect": {"contains": "trade_active"} },
    { "label": "Bora bubble", "op": "read", "what": "bubble", "player": "Bora", "expect": {"contains": "trade_active"} },
    { "label": "third player", "op": "call", "procedure": "trade_player_clicked", "args": {"entity": "Ali", "sourceentity": "Cem"} },
    { "op": "read", "what": "menu", "player": "Cem" },
    { "op": "setSlot", "player": "Ali", "slot": 0, "item": "minecraft:diamond", "count": 5 },
    { "op": "setSlot", "player": "Bora", "slot": 9, "item": "minecraft:emerald", "count": 4 },
    { "label": "Bora sees Ali's slot", "op": "read", "what": "slot", "player": "Bora", "slot": 0, "expect": "5 x minecraft:diamond" },
    { "label": "Ali sees Bora's slot", "op": "read", "what": "slot", "player": "Ali", "slot": 9, "expect": "4 x minecraft:emerald" },
    { "op": "call", "procedure": "trade_session_p100", "args": {"entity": "Ali"} },
    { "op": "call", "procedure": "trade_session_p100", "args": {"entity": "Ali"} },
    { "op": "call", "procedure": "trade_session_p10", "args": {"entity": "Bora"} },
    { "op": "call", "procedure": "trade_session_tick", "args": {"entity": "Ali"} },
    { "op": "call", "procedure": "trade_session_accept", "args": {"entity": "Ali"} },
    { "op": "setSlot", "player": "Bora", "slot": 10, "item": "minecraft:emerald", "count": 1 },
    { "op": "call", "procedure": "trade_session_tick", "args": {"entity": "Bora"} },
    { "label": "offer A", "op": "call", "procedure": "trade_session_offer_a", "args": {"entity": "Ali"} },
    { "label": "offer B", "op": "call", "procedure": "trade_session_offer_b", "args": {"entity": "Bora"} },
    { "op": "call", "procedure": "trade_session_accept", "args": {"entity": "Ali"} },
    { "op": "call", "procedure": "trade_session_accept", "args": {"entity": "Bora"} },
    { "label": "Ali money", "op": "read", "what": "var", "player": "Ali", "name": "Money", "expect": 10 },
    { "label": "Ali emeralds", "op": "read", "what": "count", "player": "Ali", "item": "minecraft:emerald", "expect": 4 },
    { "label": "Ali diamonds", "op": "read", "what": "count", "player": "Ali", "item": "minecraft:diamond" },
    { "label": "Bora money", "op": "read", "what": "var", "player": "Bora", "name": "Money", "expect": 140 },
    { "label": "Ali bubble after swap", "op": "read", "what": "bubble", "player": "Ali", "expect": {"contains": "trade_ok"} }
  ]
}
