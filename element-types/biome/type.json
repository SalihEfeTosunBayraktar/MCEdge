                },
                {
                  "value": "snowy",
                  "label": "Snowy"
                },
                {
                  "value": "taiga",
                  "label": "Taiga"
                }
              ],
              "mcreator": "villageType"
            },
            {
              "key": "oceanRuinType",
              "type": "select",
              "label": "Ocean ruins",
              "default": "NONE",
              "options": [
                {
                  "value": "NONE",
                  "label": "None"
                },
                {
                  "value": "COLD",
                  "label": "Cold"
                },
                {
                  "value": "WARM",
                  "label": "Warm"
                }
              ],
              "mcreator": "oceanRuinType"
            },
            {
              "key": "spawnRuinedPortal",
              "type": "select",
              "label": "Ruined portals",
              "default": "NONE",
              "options": [
                {
                  "value": "NONE",
                  "label": "None"
                },
                {
                  "value": "STANDARD",
                  "label": "Standard"
                },
                {
                  "value": "DESERT",
                  "label": "Desert"
                },
                {
                  "value": "JUNGLE",
                  "label": "Jungle"
                },
                {
                  "value": "SWAMP",
                  "label": "Swamp"
                },
                {
                  "value": "MOUNTAIN",
                  "label": "Mountain"
                },
                {
                  "value": "OCEAN",
                  "label": "Ocean"
                },
                {
                  "value": "NETHER",
                  "label": "Nether"
                }
              ],
              "mcreator": "spawnRuinedPortal"
            }
          ]
        }
      ]
    },
    {
      "id": "spawning",
      "title": "Entity spawning",
      "groups": [
        {
          "title": "Spawns",
          "fields": [
            {
              "key": "spawnEntries",
              "type": "list",
              "label": "Spawn entries",
              "help": "Entities that naturally spawn in this biome.",
              "default": [],
              "fields": [
                {
                  "key": "entity",
                  "type": "entity",
                  "label": "Entity",
                  "default": "",
                  "required": true,
                  "mcreator": "entity"
                },
                {
                  "key": "minGroup",
                  "type": "integer",
                  "label": "Min group size",
                  "default": 4,
                  "min": 1,
                  "max": 128,
                  "step": 1,
                  "mcreator": "minGroup"
                },
                {
                  "key": "maxGroup",
                  "type": "integer",
                  "label": "Max group size",
                  "default": 4,
                  "min": 1,
                  "max": 128,
                  "step": 1,
                  "mcreator": "maxGroup"
                },
                {
                  "key": "weight",
                  "type": "integer",
                  "label": "Weight",
                  "help": "Higher is more common.",
                  "default": 20,
                  "min": 1,
                  "max": 1000,
                  "step": 1,
                  "mcreator": "weight"
                },
                {
                  "key": "spawnType",
                  "type": "select",
                  "label": "Spawn group",
                  "default": "monster",
                  "options": [
                    {
                      "value": "monster",
                      "label": "Monster"
                    },
                    {
                      "value": "creature",
                      "label": "Creature"
                    },
                    {
                      "value": "ambient",
                      "label": "Ambient"
                    },
                    {
                      "value": "undergroundWaterCreature",
                      "label": "Underground water creature"
                    },
                    {
                      "value": "waterCreature",
                      "label": "Water creature"
                    },
                    {
                      "value": "waterAmbient",
                      "label": "Water ambient"
                    },
                    {
                      "value": "misc",
                      "label": "Misc"
                    },
                    {
                      "value": "axolotls",
                      "label": "Axolotls"
                    }
                  ],
                  "mcreator": "spawnType"
                }
              ],
              "mcreator": "spawnEntries"
            }
          ]
        }
      ]
    },
    {
      "id": "effects",
      "title": "Effects",
      "groups": [
        {
          "title": "Sounds",
          "fields": [
            {
              "key": "music",
              "type": "sound",
              "label": "Music",
              "help": "Background music while in the biome.",
              "default": "",
              "mcreator": "music"
            },
            {
              "key": "ambientSound",
              "type": "sound",
              "label": "Ambient loop",
              "help": "Looping ambient sound.",
              "default": "",
              "mcreator": "ambientSound"
            },
            {
              "key": "additionsSound",
              "type": "sound",
              "label": "Random additions",
              "help": "Short sounds played at random.",
              "default": "",
              "mcreator": "additionsSound"
            },
            {
              "key": "moodSound",
              "type": "sound",
              "label": "Mood sound",
              "help": "Cave-style sound played in dark places.",
              "default": "",
              "mcreator": "moodSound"
            },
            {
              "key": "moodSoundDelay",
              "type": "integer",
              "label": "Mood sound delay",
              "help": "Ticks between mood sounds.",
              "default": 6000,
              "min": 1,
              "max": 30000,
              "step": 1,
              "mcreator": "moodSoundDelay"
            }
          ]
        },
        {
          "title": "Particles",
          "fields": [
            {
              "key": "spawnParticles",
              "type": "boolean",
              "label": "Ambient particles",
              "help": "Float particles in the air.",
              "default": false,
              "mcreator": "spawnParticles"
            },
            {
              "key": "particleToSpawn",
              "type": "particle",
              "label": "Particle",
              "default": "",
              "required": true,
              "showIf": {
                "key": "spawnParticles",
                "equals": true
              },
              "mcreator": "particleToSpawn"
            },
            {
              "key": "particlesProbability",
              "type": "number",
              "label": "Particle density",
              "help": "Chance in percent per tick.",
              "default": 0.5,
              "min": 0,
              "max": 100,
              "step": 0.1,
              "showIf": {
                "key": "spawnParticles",
                "equals": true
              },
              "mcreator": "particlesProbability"
            }
          ]
        }
      ]
    }
  ]
}
