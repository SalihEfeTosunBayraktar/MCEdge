                  "value": "bottom",
                  "label": "Bottom"
                },
                {
                  "value": "bottom_right",
                  "label": "Bottom right"
                }
              ]
            },
            {
              "key": "scaleMode",
              "type": "select",
              "label": "Size",
              "help": "Follow the GUI scale: one canvas pixel is one GUI pixel, so the player's GUI scale sets the size. Fixed GUI scale: the same size whatever the player's setting. Fill the screen: the canvas grows and shrinks with the window.",
              "default": "gui",
              "options": [
                {
                  "value": "gui",
                  "label": "Follow the GUI scale"
                },
                {
                  "value": "fixed",
                  "label": "Fixed GUI scale"
                },
                {
                  "value": "fit",
                  "label": "Fill the screen"
                }
              ]
            },
            {
              "key": "fixedScale",
              "type": "integer",
              "label": "GUI scale",
              "help": "Window pixels per canvas pixel.",
              "default": 2,
              "min": 1,
              "max": 8,
              "step": 1,
              "showIf": {
                "key": "scaleMode",
                "equals": "fixed"
              }
            }
          ]
        },
        {
          "title": "Editor grid",
          "fields": [
            {
              "key": "gridSx",
              "type": "integer",
              "label": "Grid width",
              "default": 18,
              "min": 1,
              "max": 512,
              "step": 1,
              "mcreator": "gridSettings.sx"
            },
            {
              "key": "gridSy",
              "type": "integer",
              "label": "Grid height",
              "default": 18,
              "min": 1,
              "max": 512,
              "step": 1,
              "mcreator": "gridSettings.sy"
            },
            {
              "key": "gridOx",
              "type": "integer",
              "label": "Grid offset X",
              "default": 11,
              "min": -512,
              "max": 512,
              "step": 1,
              "mcreator": "gridSettings.ox"
            },
            {
              "key": "gridOy",
              "type": "integer",
              "label": "Grid offset Y",
              "default": 15,
              "min": -512,
              "max": 512,
              "step": 1,
              "mcreator": "gridSettings.oy"
            },
            {
              "key": "gridSnap",
              "type": "boolean",
              "label": "Snap to grid",
              "default": false,
              "mcreator": "gridSettings.snapOnGrid"
            }
