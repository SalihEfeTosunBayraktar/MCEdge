{
  "$comment": "How to do by hand what an AI action did (Q251). Shown under a call in the agent timeline and under a tool row of the AI panel. rules: the first whose `tools` regex matches the MCP tool name gives the path; a tool with no rule (reads, notes, tasks) shows none. steps: '@key' is the UI string of that key in the user's language, so the path names the menus and sections the way the app does and follows a rename; '{type}' the element type's name, '{id}' the element id, '{path}' the file or resource path, '{page}' the page (tab) of the element editor the first changed field is on, '{field}' the labels of the changed fields. A step whose placeholder cannot be filled is left out; a path with a step Simple mode hides is not shown (the user cannot follow it).",
  "separator": " > ",
  "rules": [
    { "tools": "^(create_element|create_from_template|batch_elements)$", "steps": ["@section.elements", "@new.title", "{type}"] },
    { "tools": "^update_element$", "steps": ["@section.elements", "{id}", "{page}", "{field}"] },
    { "tools": "^clone_elements$", "steps": ["@section.elements", "{id}", "@editor.elementMenu", "@action.duplicate"] },
    { "tools": "^delete_element$", "steps": ["@section.elements", "{id}", "@editor.elementMenu", "@action.delete"] },
    { "tools": "^rename_element$", "steps": ["@section.elements", "{id}", "@editor.elementMenu", "@action.rename"] },
    { "tools": "^(move_to_folder|edit_folder)$", "steps": ["@section.elements", "@folders.actions"] },
    { "tools": "^(write_procedure)$", "steps": ["@section.elements", "{id}", "@proc.program"] },
    { "tools": "^(write_gui_layout|write_tab_order|lock_element_code|unlock_element_code)$", "steps": ["@section.elements", "{id}"] },
    { "tools": "^create_texture$", "steps": ["@menu.resources", "@menu.createTexture"] },
    { "tools": "^(import_texture|import_resources)$", "steps": ["@menu.resources", "@menu.importTextures"] },
    { "tools": "^(adjust_texture|draw_texture_shapes|edit_texture_region|flip_texture|resize_texture|resize_texture_canvas|write_texture_pixels|set_texture_animation|copy_texture|edit_in_blockbench)$", "steps": ["@section.resources", "{path}"] },
    { "tools": "^(delete_texture|delete_resource)$", "steps": ["@section.resources", "{path}", "@resources.delete"] },
    { "tools": "^(set_sound_event|delete_sound_event)$", "steps": ["@section.resources", "@resources.item.sounds"] },
    { "tools": "^(set_translations|import_translations)$", "steps": ["@section.localization"] },
    { "tools": "^add_language$", "steps": ["@section.localization", "@localization.addLanguage"] },
    { "tools": "^rename_language$", "steps": ["@section.localization", "@localization.renameLanguage"] },
    { "tools": "^remove_language$", "steps": ["@section.localization", "@localization.removeLanguage"] },
    { "tools": "^(set_tag|delete_tag)$", "steps": ["@section.tags"] },
    { "tools": "^set_variables$", "steps": ["@section.variables"] },
    { "tools": "^(update_mod|change_mod_identity|set_integration)$", "steps": ["@section.settings"] },
    { "tools": "^(edit_file|write_file)$", "steps": ["@section.code", "{path}"] },
    { "tools": "^create_project$", "steps": ["@menu.file", "@menu.newProject"] },
    { "tools": "^create_pack$", "steps": ["@menu.tools", "@menu.createPack"] },
    { "tools": "^import_workspace_zip$", "steps": ["@menu.file", "@menu.importZip"] },
    { "tools": "^export_jar$", "steps": ["@menu.file", "@menu.exportJar"] },
    { "tools": "^build$", "steps": ["@menu.buildRun", "@top.build"] },
    { "tools": "^regenerate_code$", "steps": ["@menu.buildRun", "@menu.regenerate"] },
    { "tools": "^run_client$", "steps": ["@menu.buildRun", "@top.run"] },
    { "tools": "^stop_client$", "steps": ["@menu.buildRun", "@top.stop"] },
    { "tools": "^debug_client$", "steps": ["@menu.buildRun", "@menu.debugClient"] },
    { "tools": "^run_server$", "steps": ["@menu.buildRun", "@menu.runServer"] },
    { "tools": "^stop_server$", "steps": ["@menu.buildRun", "@menu.stopServer"] },
    { "tools": "^gradle_task$", "steps": ["@menu.buildRun", "@menu.runGradleTask"] },
    { "tools": "^git_(init|stage|unstage|commit|discard|revert|pull|push|create_branch|switch_branch)$", "steps": ["@section.git"] }
  ]
}
