{
  "name": "mcedge",
  "version": "0.1.2",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Block-based, AI-collaborative Minecraft mod editor (core)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:ui": "node tools/ui-test/run-all.ts",
    "mcedge": "node src/cli.ts",
    "dev": "electron-vite dev",
    "build:app": "electron-vite build && vite build -c vite.cli.config.ts",
    "start": "electron-vite preview",
    "dist": "npm run build:app && electron-builder --win --publish never",
    "release": "npm run build:app && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.0",
    "vite": "7.3.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "blockly": "13.3.0",
    "electron-updater": "6.8.10",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "main": "out/main/index.js",
  "productName": "MCEdge",
  "author": "Salih Efe Tosun",
  "homepage": "https://github.com/SalihEfeTosunBayraktar/MCEdge",
  "repository": {
    "type": "git",
    "url": "https://github.com/SalihEfeTosunBayraktar/MCEdge.git"
  }
}
